generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid()) @map("_id") // Unique identifier
  clerkId    String    @unique              // Clerk-provided ID
  email      String    @unique              // User's email
  username   String                          // User's username
  name       String?                         // User's full name from Clerk
  createdAt  DateTime  @default(now())      // Timestamp of user creation
  // add another table like this
  // tempTexts  demo[]                     // Relation to TempText
}

